	if((newkeys & KEY_WALK))
	{
		new id = -1;
		id = GetClosestATM(playerid);
		if(id > -1)
		{
			return callcmd::atm(playerid, "");
		}
	}
	if((newkeys & KEY_WALK))
	{
		if(pData[playerid][pJob] == 6 || pData[playerid][pJob2] == 6)
