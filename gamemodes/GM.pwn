public OnPlayerExitVehicle(playerid, vehicleid)
{
    if(pData[playerid][pDriveLicApp] > 0)
	{
		//new vehicleid = GetPlayerVehicleID(playerid);
		if(GetVehicleModel(vehicleid) == 602)
		{
		    DisablePlayerCheckpoint(playerid);
			DisablePlayerRaceCheckpoint(playerid);
		    Info(playerid, "Anda Dengan Sengaja Keluar Dari Mobil Latihan, Anda Telah "RED_E"DIDISKUALIFIKASI.");
		    RemovePlayerFromVehicle(playerid);
		    pData[playerid][pDriveLicApp] = 0;
		    SetTimerEx("RespawnPV", 3000, false, "d", vehicleid);
		}
	}
	return 1;
}

public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
    if (pData[playerid][pAdmin] >= 4)
    {
        new vehicleid = GetPlayerVehicleID(playerid);
        if(vehicleid > 0 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
                SetVehiclePos(vehicleid, fX, fY, fZ+10);
        }
        else
        {
                SetPlayerPosFindZ(playerid, fX, fY, 999.0);
                SetPlayerVirtualWorld(playerid, 0);
                SetPlayerInterior(playerid, 0);
        }
        Info(playerid, "Kamu Telah Berhasil Teleport Ke Marker Di Peta di peta.");
    }
    return 1;
}

stock SendDiscordMessage(channel, message[]) {
	new DCC_Channel:ChannelId;
	switch(channel)
	{
		//==[ Log Join & Leave ]
		case 0:
		{
			ChannelId = DCC_FindChannelById("1542187539194978374");
			DCC_SendChannelMessage(ChannelId, message);
			return 1;
		}
		//==[ Log Command ]
		case 1:
		{
			ChannelId = DCC_FindChannelById("1543133401681240135");
			DCC_SendChannelMessage(ChannelId, message);
			return 1;
		}
		//==[ Log Chat IC ]
		case 2:
		{
			ChannelId = DCC_FindChannelById("1543132867914375178");
			DCC_SendChannelMessage(ChannelId, message);
			return 1;
		}
		//==[ Warning & Banned ]
		case 3:
		{
			ChannelId = DCC_FindChannelById("1541771522304122920");
			DCC_SendChannelMessage(ChannelId, message);
			return 1;
		}
		//==[ Log Death ]
		case 4:
		{
			ChannelId = DCC_FindChannelById("1541771152198729758");
			DCC_SendChannelMessage(ChannelId, message);
			return 1;
		}
		//==[ Ucp ]
		case 5:
		{
			ChannelId = DCC_FindChannelById("1028316848355295264");
			DCC_SendChannelMessage(ChannelId, message);
			return 1;
		}
		case 6://Korup
		{
			ChannelId = DCC_FindChannelById("1541771413973901312");
			DCC_SendChannelMessage(ChannelId, message);
			return 1;
		}
		case 7://Register
		{
			ChannelId = DCC_FindChannelById("1541774064396406855");
			DCC_SendChannelMessage(ChannelId, message);
			return 1;
		}
		case 8://Bot Admin
		{
			ChannelId = DCC_FindChannelById("1543133068347449365");
			DCC_SendChannelMessage(ChannelId, message);
			return 1;
		}
		case 9://==[ Log CMD Admin ]
		{
			ChannelId = DCC_FindChannelById("1543133188984021042");
			DCC_SendChannelMessage(ChannelId, message);
			return 1;
		}
	}
	return 1;
}

CompasArivenaTheater(playerid)
{
	new CompasText[8][MAX_PLAYERS];
	new Float:rz;
	new CompasPrev[8];

	strcat((CompasPrev[0] = EOS, CompasPrev), CompasText[playerid]);

	if(IsPlayerInAnyVehicle(playerid))
	{
		GetVehicleZAngle(GetPlayerVehicleID(playerid), rz);
	}
	else
	{
		GetPlayerFacingAngle(playerid, rz);
	}

	if(rz >= 348.75 || rz < 11.25) CompasText[playerid] = "North";
	else if(rz >= 258.75 && rz < 281.25) CompasText[playerid] = "East";
    else if(rz >= 210.0 && rz < 249.0) CompasText[playerid] = "South East";
	else if(rz >= 168.75 && rz < 191.25) CompasText[playerid] = "South";
    else if(rz >= 110.0 && rz < 159.0)  CompasText[playerid] = "South West";
	else if(rz >= 78.75 && rz < 101.25) CompasText[playerid] = "West";
    else if(rz >= 20 && rz < 78.74) CompasText[playerid] = "West Sea";
    else if(rz >= 291.0 && rz < 339) CompasText[playerid] = "North East";

    new gacor[256];
	new Float:xzz, Float:yzz, Float:zzz;
	GetPlayerPos(playerid, xzz, yzz, zzz);
	format(gacor, sizeof gacor, "%s l %s", CompasText[playerid], GetLocation(xzz, yzz, zzz));
   	PlayerTextDrawSetString(playerid, ALocation[playerid], gacor);
	return 1;
}

