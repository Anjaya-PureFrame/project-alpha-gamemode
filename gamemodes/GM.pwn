			new str[1024];
			format(str, sizeof(str), "Nama Kendaraan\nPenyiar\nSanchez");
			ShowPlayerDialog(playerid, DIALOG_SANAVEH, DIALOG_STYLE_TABLIST_HEADERS, "Garasi Liputan Cerita Kita", str, "Pilih", "Tutup");
		}
